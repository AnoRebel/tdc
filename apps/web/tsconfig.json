{
  // Nuxt generates the real configurations into .nuxt; this file only points
  // at them, so `nuxt typecheck` and editors resolve the same settings the
  // build uses.
  "files": [],
  "references": [
    { "path": "./.nuxt/tsconfig.app.json" },
    { "path": "./.nuxt/tsconfig.server.json" },
    { "path": "./.nuxt/tsconfig.shared.json" },
    { "path": "./.nuxt/tsconfig.node.json" }
  ]
}
