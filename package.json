{
  "name": "tdc",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": {
    "packages": [
      "apps/web",
      "apps/desktop/frontend",
      "packages/*"
    ],
    "catalog": {
      "@tdc/types": "workspace:*",
      "@tdc/ui": "workspace:*"
    },
    "catalogs": {
      "vue": {
        "nuxt": "^4.5.2",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1",
        "@vueuse/core": "^14.4.0",
        "@vueuse/nuxt": "^14.4.0",
        "reka-ui": "^2.10.4"
      },
      "tooling": {
        "typescript": "^6.0.3",
        "vue-tsc": "^3.3.11",
        "eslint": "^10.10.0",
        "eslint-plugin-vue": "^10.11.0",
        "vue-eslint-parser": "^10.4.1",
        "typescript-eslint": "^8.70.0",
        "@eslint/js": "^10.0.1",
        "globals": "^17.12.0",
        "prettier": "^3.9.7"
      },
      "testing": {
        "vitest": "^5.0.1",
        "@vue/test-utils": "^2.5.1",
        "happy-dom": "^20.14.5",
        "@vitejs/plugin-vue": "^6.0.9"
      },
      "utils": {
        "date-fns": "^4.4.0",
        "@date-fns/tz": "^1.5.0",
        "valibot": "^1.5.0",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.7.0",
        "class-variance-authority": "^0.7.1"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "catalog:tooling",
    "@types/node": "^26.6.1",
    "eslint": "catalog:tooling",
    "eslint-plugin-vue": "catalog:tooling",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "catalog:tooling",
    "lefthook": "^2.1.14",
    "prettier": "catalog:tooling",
    "typescript": "catalog:tooling",
    "typescript-eslint": "catalog:tooling",
    "vue-eslint-parser": "catalog:tooling"
  },
  "trustedDependencies": [
    "lefthook"
  ],
  "scripts": {
    "postinstall": "lefthook install",
    "version:sync": "bun run scripts/sync-version.ts",
    "version:check": "bun run scripts/sync-version.ts --check",
    "dev": "bun run --filter=@tdc/web dev",
    "dev:web": "bun run --filter=@tdc/web dev",
    "dev:server": "cd server && air",
    "dev:desktop": "cd apps/desktop && wails3 dev",
    "build": "bun run --filter=@tdc/web build",
    "build:web": "bun run --filter=@tdc/web build",
    "build:server": "cd server && go build -o ../bin/tdc-server ./cmd/tdc-server",
    "build:desktop": "cd apps/desktop && wails3 task build",
    "typecheck": "bun run --filter=@tdc/web --filter=@tdc/types --filter=@tdc/desktop-frontend typecheck",
    "lint": "bun run --filter=@tdc/web --filter=@tdc/types --filter=@tdc/desktop-frontend --filter=@tdc/ui lint",
    "lint:fix": "bun run --filter=@tdc/web --filter=@tdc/types lint:fix",
    "lint:go": "cd server && golangci-lint run",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,js,json,md}\"",
    "test": "bun run --filter=@tdc/web --filter=@tdc/types --filter=@tdc/desktop-frontend test",
    "test:go": "cd server && go test -race ./...",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/*/node_modules packages/*/node_modules bin"
  }
}
