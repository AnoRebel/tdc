# Copy to .env for local development. Never commit .env.
#
# The test database URL points at the compose database's host port. Note that
# it is 55433, not 55432 — the latter belongs to an unrelated project on this
# machine, and pointing tests at it would write into the wrong database.
TDC_TEST_DATABASE_URL=postgres://tdc:tdc@127.0.0.1:55433/tdc?sslmode=disable

# Server configuration for running outside compose.
TDC_DATABASE_URL=postgres://tdc:tdc@127.0.0.1:55433/tdc?sslmode=disable
TDC_SERVER_CANONICAL_ADDRESS=localhost:8080
TDC_SERVER_ALLOWED_ORIGINS=http://localhost:3000

# The web app must reach the API on the SAME HOST as it is served from, or the
# browser treats the session cookie as third-party and SameSite=Lax blocks it.
# localhost:3000 and 127.0.0.1:8080 are different hosts for this purpose.
NUXT_PUBLIC_API_BASE=http://localhost:8080
TDC_LOG_FORMAT=text

# Where uploaded files are kept. The default keeps them in a directory, so a
# small deployment needs no object store at all.
#
#   local     — a directory on this machine (the default)
#   s3-aws    — an S3-compatible store, through the AWS SDK
#   s3-minio  — the same stores, through the smaller minio-go client
#
# The two S3 backends talk to the same object stores and behave identically;
# pick whichever client you would rather have in the dependency tree. Garage
# and SeaweedFS are both good self-hosted choices for the store itself.
TDC_STORAGE_BACKEND=local
TDC_STORAGE_DIRECTORY=./data/attachments
# TDC_STORAGE_S3_ENDPOINT=http://127.0.0.1:8333
# TDC_STORAGE_S3_BUCKET=tdc-attachments
# TDC_STORAGE_S3_ACCESS_KEY=
# TDC_STORAGE_S3_SECRET_KEY=

# Running the object-store tests needs a real S3-compatible server, because a
# mock would only prove the code calls the functions the test expects. Start
# one, create no bucket (the tests make their own), and point this at it:
#
#   docker run -d --name tdc-s3 -p 8333:8333 \
#     -v "$PWD/dev/seaweedfs-s3.json:/etc/seaweedfs/s3.json:ro" \
#     chrislusf/seaweedfs:latest \
#     server -s3 -s3.config=/etc/seaweedfs/s3.json -dir=/data
#
# The tests skip without it, so this is optional.
# TDC_TEST_S3_ENDPOINT=http://127.0.0.1:8333

# Malware scanning is optional and off by default: this server must work with
# no external service, which is what makes it free to self-host.
#
# To enable it, run clamd and point this at it. ClamAV is the only scanner that
# is free, open source and self-hostable:
#
#   docker run -d --name clamav -p 3310:3310 clamav/clamav:stable
#
# TDC_ATTACHMENTS_SCANNER_ADDRESS=127.0.0.1:3310
# TDC_ATTACHMENTS_SCANNER_TIMEOUT=30s
#
# When the scanner cannot be reached, an upload is refused. Setting this to
# true accepts it instead — a reasonable choice for a small community that
# would rather stay usable, but it means the protection disappears exactly when
# something is wrong, so it should be a decision rather than a default.
# TDC_ATTACHMENTS_SCANNER_FAIL_OPEN=false

# Preview generation runs inside the server by default, which is safe: image
# decoding is pure Go and the binary builds with CGO disabled, so there is no
# image library in C to be exploited, and a decompression bomb is refused from
# its header before a pixel is allocated.
#
# A large or public deployment may still want a decoder failure to take down a
# disposable container rather than the server. To do that:
#
#   docker compose --profile media up -d
#
# then point the server at it. The container has no route to the internet, no
# access to the database, a read-only filesystem, no capabilities, and a memory
# cap. If it is unreachable, attachments are still stored and served — they
# simply arrive without a preview.
# TDC_ATTACHMENTS_MEDIA_SIDECAR_ADDRESS=http://media:8081
# TDC_ATTACHMENTS_MEDIA_SIDECAR_TIMEOUT=30s
