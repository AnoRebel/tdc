# Build the optional media processor.
#
# A separate image from the server because it is a separate risk: this one
# decodes images somebody else uploaded, and the point of running it apart is
# that a decoder failure takes down a container holding nothing.
FROM golang:1.27-alpine AS build

WORKDIR /src

COPY server/go.mod server/go.sum ./
RUN go mod download

COPY server/ ./

# CGO disabled, so the result is a static binary with no C image library in it
# — which is why the server can safely do this work itself when no sidecar is
# configured, and why this container needs nothing from a base image.
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/tdc-media ./cmd/tdc-media

# scratch rather than alpine: this process opens no files, resolves no names,
# and runs no shell. Giving it a userland would only give an exploit somewhere
# to stand.
FROM scratch

COPY --from=build /out/tdc-media /tdc-media

# An unprivileged, nonexistent user. There is no /etc/passwd here to name one,
# so the numeric id is the whole of it — which is enough, since nothing on the
# filesystem is writable anyway.
USER 10001:10001

EXPOSE 8081

ENTRYPOINT ["/tdc-media"]
